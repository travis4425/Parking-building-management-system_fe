# =============================================================================
# ParkingOS — Environment Variables Template
# Sao chép file này thành .env rồi điền giá trị thật.
# KHÔNG commit file .env lên Git (đã có trong .gitignore).
# =============================================================================

# ── Google Gemini AI ──────────────────────────────────────────────────────────
# Dùng cho: Gợi ý slot tối ưu (CheckIn), Nhận diện biển số LPR (camera)
#
# Lấy API key MIỄN PHÍ (không cần thẻ ngân hàng):
#   1. Truy cập https://aistudio.google.com/app/apikey
#   2. Đăng nhập bằng tài khoản Google
#   3. Nhấn "Create API key" → chọn project hoặc tạo mới
#   4. Copy key và dán vào đây
#
# Free tier: 15 request/phút, 1.000.000 token/ngày (đủ cho demo)
# Model sử dụng: gemini-2.5-flash (nhanh, chính xác, miễn phí)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ── Backend REST API ──────────────────────────────────────────────────────────
# URL server backend (FastAPI / Node.js / Spring Boot).
# Để trống hoặc comment nếu chạy hoàn toàn với mock data (mặc định dự án này).
VITE_API_BASE_URL=http://localhost:8080/api

# ── Socket.IO Realtime ────────────────────────────────────────────────────────
# URL Socket.IO server cho cập nhật trạng thái slot real-time.
# Để trống nếu chưa có backend (IoT simulation dùng setInterval thay thế).
VITE_SOCKET_URL=http://localhost:8080
